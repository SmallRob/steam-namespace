{
  "v": 1,
  "updatedAt": "2026-10-20T00:20:00Z",
  "note": "Steam 插件体系版本契约。AI Agent 读它来回答「装齐了吗」「版本过旧吗」「某个插件装了没」。运行时实际版本由各插件通过共享宿主 registerPlugin() 注册到 IndexedDB，本文件提供「期望清单 + 最低版本 + 探测信号」。⚠️ 三来源分工：契约=期望（装什么/最低版本）｜registerPlugin=实况（精确版本号）｜探测=兜底（装了但没注册的插件）。",
  "registry": {
    "mechanism": "indexedDB",
    "db": "sglv_plugin_host_storage",
    "store": "kv",
    "prefix": "shared:plugin:",
    "record": {
      "id": "插件唯一标识（小写字母/数字/连字符）",
      "name": "显示名",
      "family": "所属分组（见 families）",
      "version": "版本号（自动取自脚本头部 @version，永不漂移）",
      "versionSource": "spec（显式传）| GM_info（自动取）",
      "capabilities": "可选，能力标记",
      "ts": "注册时刻（ms）—— 超过 7 天未刷新视为「装过但很久没运行」"
    },
    "writer": "shared/sglv-plugin-host.lib.js → __PLUGIN_HOST__.registerPlugin({id, name, family})",
    "reader": "steam-ai-agent → getInstalledPlugins 工具",
    "hostLib": {
      "source": "SmallRob/steam-userscripts（私有）shared/sglv-plugin-host.lib.js",
      "cdn": "https://cdn.jsdelivr.net/gh/SmallRob/steam-namespace@main/libs/sglv-plugin-host.lib.js",
      "version": "0.3.0"
    },
    "notes": [
      "GM 存储按脚本沙箱隔离 → 跨脚本读不到别人的 GM 值 → 版本必须靠 registerPlugin 显式注册",
      "IndexedDB 同源全脚本共享 → registerPlugin 写的键对 AI Agent 直接可读",
      "未接入 registerPlugin 的插件：只能靠 detect 信号判断「装没装」，版本显示为「未知」"
    ]
  },
  "families": {
    "core": {
      "label": "核心三件套",
      "desc": "游戏库展示 + 愿望单侧边栏 + 家庭组分析"
    },
    "social": {
      "label": "好友系",
      "desc": "好友管理器 + 好友监控系列"
    },
    "market": {
      "label": "市场系",
      "desc": "社区市场增强"
    },
    "account": {
      "label": "账户系",
      "desc": "许可分类 + 消费历史分类"
    },
    "badge": {
      "label": "徽章系",
      "desc": "徽章卡牌视图"
    },
    "utility": {
      "label": "工具系",
      "desc": "点数商店 / 货币换算 / SteamDB 等"
    },
    "ai": {
      "label": "AI 系",
      "desc": "Steam AI Agent"
    }
  },
